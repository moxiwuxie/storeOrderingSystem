page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  min-height: 100vh;
}

.btn-primary {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
}

.btn-primary[disabled] {
  background: #ffc3ab;
  color: #fff;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}

.price {
  color: #ff3b30;
  font-weight: 600;
}

.price::before {
  content: '¥';
  font-size: 22rpx;
}
