.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff8a5c, #ff6b35);
  padding: 60rpx 32rpx;
  color: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.profile-info {
  margin-left: 24rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
}

.bind {
  margin-top: 10rpx;
}

.tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.login-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  font-size: 24rpx;
  border: 2rpx solid #fff;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
}

.quick {
  display: flex;
}

.quick-item {
  flex: 1;
  text-align: center;
}

.quick-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b35;
}

.quick-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-row:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
}
