<view class="container">
  <view class="icon">{{success ? '✅' : '⏳'}}</view>
  <view class="title">{{success ? '支付成功' : '支付未完成'}}</view>
  <view class="sub" wx:if="{{order}}">订单号：{{order.order_no}}</view>
  <view class="sub" wx:if="{{order}}">支付金额：¥{{order.pay_amount}}</view>

  <view class="actions">
    <view class="btn-outline" bindtap="goMenu">继续点单</view>
    <view class="btn-primary" bindtap="goOrders">查看订单</view>
  </view>
</view>
