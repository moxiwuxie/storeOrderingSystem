.row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
}

.row-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  max-width: 400rpx;
}

.qty {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 2rpx solid #eee;
  border-radius: 50%;
  font-size: 28rpx;
}

.qty-num {
  width: 72rpx;
  text-align: center;
}

.row-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.del {
  font-size: 24rpx;
  color: #999;
}

.subtotal {
  font-size: 24rpx;
  color: #666;
}

.clear {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.total {
  font-size: 30rpx;
}

.cart-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 30rpx;
}

.empty-wrap {
  padding-top: 180rpx;
  text-align: center;
}

.go-menu {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}
