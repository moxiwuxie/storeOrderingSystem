.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 26rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #ff6b35;
  font-weight: 600;
  border-bottom-color: #ff6b35;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.status-0 { color: #ff6b35; }
.status-1 { color: #1890ff; }
.status-2 { color: #52c41a; }
.status-3 { color: #999999; }

.order-body {
  padding: 16rpx 0;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 8rpx 0;
}

.gi-spec {
  font-size: 22rpx;
  color: #999;
}

.gi-qty {
  color: #999;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.time {
  color: #999;
}

.empty-wrap {
  padding-top: 180rpx;
  text-align: center;
}

.go-menu {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}
