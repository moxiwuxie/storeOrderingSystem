.menu {
  display: flex;
  height: 100vh;
}

.cats {
  width: 190rpx;
  background: #f0f0f0;
  height: 100%;
}

.cat-item {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  text-align: center;
  color: #666;
}

.cat-item.active {
  background: #fff;
  color: #ff6b35;
  font-weight: 600;
  border-left: 6rpx solid #ff6b35;
}

.goods {
  flex: 1;
  background: #fff;
  height: 100%;
}

.cat-title {
  padding: 20rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: #999;
}

.goods-item {
  display: flex;
  padding: 20rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #f5f5f5;
}

.thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #ff6b35;
  font-weight: 700;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
}

.goods-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}

.goods-bottom {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.price {
  font-size: 34rpx;
}

.stock {
  font-size: 22rpx;
  color: #999;
}

.add-btn {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  font-size: 38rpx;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.cart-icon.on {
  background: #ff6b35;
}

.cart-info {
  margin-left: 20rpx;
}

.cart-amount {
  font-size: 28rpx;
}

.cart-count {
  font-size: 22rpx;
  color: #999;
}

.cart-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 30rpx;
}

.cart-btn.disabled {
  background: #ccc;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

.spec-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 11;
}

.spec-title {
  font-size: 34rpx;
  font-weight: 700;
}

.spec-sub {
  font-size: 24rpx;
  color: #999;
  margin: 12rpx 0 20rpx;
}

.spec-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.spec-item.active {
  border-color: #ff6b35;
  background: #fff5f0;
  color: #ff6b35;
}

.spec-item.disabled {
  color: #ccc;
}

.spec-stock {
  font-size: 22rpx;
  color: #999;
}

.spec-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.qty {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border: 2rpx solid #eee;
  border-radius: 50%;
  font-size: 32rpx;
}

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

.spec-confirm {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
}
