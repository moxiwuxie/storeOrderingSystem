# 复制为 .env 后按需修改

# 应用
APP_NAME=门店扫码点单系统
DEBUG=true
# 本地零配置开发默认使用 SQLite；生产请改成 MySQL
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/store_ordering?charset=utf8mb4
DATABASE_URL=sqlite:///./store_ordering.db

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRE_MINUTES=10080
ADMIN_JWT_EXPIRE_MINUTES=720

# 默认管理员（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 微信小程序（微信公众平台获取）
WECHAT_APPID=
WECHAT_SECRET=
# 开发模式：不请求微信服务器，用 code 生成模拟 openid，方便本地联调
WECHAT_MOCK=true

# 支付宝（开放平台获取）
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_MOCK=true

# 支付模式：mock=本地模拟支付成功；real=调用真实渠道
PAY_MODE=mock
# 微信支付 v3
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=http://127.0.0.1:8000/api/payment/wechat/notify
ALIPAY_NOTIFY_URL=http://127.0.0.1:8000/api/payment/alipay/notify

# 业务
# 门店自提/桌号等场景可开启，下单时必填备注
NEED_TABLE_NO=false
